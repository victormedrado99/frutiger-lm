[Unit]
Description=Frutiger LM - notebooks de estudo com fontes, grafo de conhecimento e outputs
# O app NAO depende mais de nenhum motor externo: o agente LangGraph vive dentro
# dele (F1 concluida). Por isso nao ha After=hermes-gateway.service nem Wants=.
#
# Isso tambem elimina por construcao a armadilha antiga: com Wants= num servico
# que pode ter sido iniciado fora do systemd (via `hermes gateway restart`), cada
# start do app disparava um start do gateway que falhava com "Gateway already
# running" e entrava em loop de restart.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# %h = seu diretorio home. Ajuste se clonou o projeto em outro lugar.
ExecStart=%h/Projetos/caderno/.venv/bin/frutiger-lm
WorkingDirectory=%h/Projetos/caderno
Environment="VIRTUAL_ENV=%h/Projetos/caderno/.venv"
Environment="PATH=%h/Projetos/caderno/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
