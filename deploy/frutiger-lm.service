[Unit]
Description=Frutiger LM - notebooks de estudo com fontes, grafo de conhecimento e outputs
# O app NAO depende de nenhum motor externo: o agente LangGraph vive dentro dele.
# Por isso nao ha After= nem Wants= apontando para servico de fora.
#
# E ha um motivo concreto para manter assim: um unit que declara Wants= num servico
# que pode ter sido iniciado FORA do systemd entra em laco — cada start do app
# dispara um start do outro, que falha com "already running", e o Restart=always
# dele reinicia para sempre. Nao dependa de servico que sobe por fora.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# %h = seu diretorio home. Ajuste se clonou o projeto em outro lugar.
ExecStart=%h/Projetos/caderno/.venv/bin/frutiger-lm
WorkingDirectory=%h/Projetos/caderno
Environment="VIRTUAL_ENV=%h/Projetos/caderno/.venv"
Environment="PATH=%h/Projetos/caderno/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
