[Unit]
Description=Frutiger LM - notebooks de estudo com fontes, grafo de conhecimento e outputs
# After= ordena (o motor sobe antes), mas NAO use Wants=hermes-gateway.service
# aqui: o gateway pode ter sido iniciado fora do systemd (via `hermes gateway
# restart`), e um Wants= faz o app disparar tentativas de start que falham com
# "Gateway already running" e entram em loop de restart.
#
# Esta dependencia do gateway desaparece na F1, quando o motor passa a ser o
# agente LangGraph proprio do app (PROJETO.md).
After=network-online.target hermes-gateway.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# %h = seu diretorio home. Ajuste se clonou o projeto em outro lugar.
ExecStart=%h/Projetos/caderno/.venv/bin/frutiger-lm
WorkingDirectory=%h/Projetos/caderno
Environment="VIRTUAL_ENV=%h/Projetos/caderno/.venv"
Environment="PATH=%h/Projetos/caderno/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
