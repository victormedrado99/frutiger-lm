# Frutiger LM — configuração
# Copie para .env e ajuste:  cp .env.example .env

# ---------------------------------------------------------------------------
# MODELO
# ---------------------------------------------------------------------------
# Normalmente você NÃO precisa mexer aqui: clique em "Modelo" na tela inicial,
# escolha o provedor e cole a sua chave. Isso fica salvo em
# data/model.json com permissão 600, e nunca volta para o navegador.
#
# Estas variáveis são o caminho alternativo, para quem prefere versionar a
# configuração em vez de clicar (VPS, por exemplo). A UI ganha se estiver
# preenchida — ela foi o caminho usado por último de forma explícita.
#
# Formato: openai|<endereco>|<modelo>|<chave>
# Todo provedor abaixo fala OpenAI-compatível, então é sempre o mesmo cliente.
#
#   LLM_AGENT=openai|https://api.deepseek.com/v1|deepseek-chat|sk-...
#   LLM_AGENT=openai|https://api.openai.com/v1|gpt-4o-mini|sk-...
#   LLM_AGENT=openai|https://openrouter.ai/api/v1|<modelo>|sk-or-...
#   LLM_AGENT=openai|http://127.0.0.1:1234/v1|<modelo>|local     (LM Studio)
#   LLM_AGENT=openai|http://127.0.0.1:8080/v1|<modelo>|local     (llama.cpp)
#
# Endereço local não precisa de chave de verdade: a lib exige o campo, mas o
# servidor local ignora o valor.
LLM_AGENT=

# ---------------------------------------------------------------------------
# APP (opcional, tem default)
# ---------------------------------------------------------------------------
# Onde ficam o banco SQLite, os arquivos das fontes e a config do modelo.
# ATENÇÃO: este diretório contém a sua chave de API. Não compartilhe nem versione.
FRUTIGER_DATA_DIR=./data

# Porta do app.
FRUTIGER_PORT=8765

# A partir de quantos caracteres o conteúdo das fontes deixa de ser injetado
# inteiro no prompt e passa a ser lido pelas ferramentas do agente.
# 24000 chars ~ 6k tokens. Aumente se o seu modelo tiver contexto grande.
FRUTIGER_INLINE_LIMIT=24000
