# Caderno — configuração
# Copie para .env e ajuste:  cp .env.example .env

# ---------------------------------------------------------------------------
# MOTOR: o Hermes Agent (obrigatório)
# ---------------------------------------------------------------------------
# Endereço do API server do gateway do Hermes.
# Ligue com: API_SERVER_ENABLED=true no ~/.hermes/.env e reinicie o gateway.
HERMES_URL=http://127.0.0.1:8642

# A mesma chave que você pôs em API_SERVER_KEY no ~/.hermes/.env
HERMES_KEY=troque-esta-chave

# Identificador estável deste usuário no Hermes (memória de longo prazo).
# Vira o header X-Hermes-Session-Key. Deixe um por pessoa.
CADERNO_SESSION_KEY=caderno:local:

# ---------------------------------------------------------------------------
# VR (opcional, tem default)
# ---------------------------------------------------------------------------
# Onde ficam o banco SQLite e os arquivos das fontes.
CADERNO_DATA_DIR=./data

# Porta do app.
CADERNO_PORT=8765

# A partir de quantos caracteres o conteúdo das fontes deixa de ser
# injetado inteiro no prompt e passa a ser consultado pelo agente via tools.
# 24000 chars ~ 6k tokens. Aumente se seu modelo tiver contexto grande.
CADERNO_INLINE_LIMIT=24000

# Modelo usado nos outputs (resumos, guias, FAQ...). Vazio = o padrão do Hermes.
CADERNO_OUTPUT_MODEL=
